      <aliases enabled='yes' />
      <column caption='Sales Growth %' datatype='real' name='[Calculation_1755680239546368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Total Revenue]) - LOOKUP(SUM([Total Revenue]), -1)) / LOOKUP(SUM([Total Revenue]), -1) * 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Average Discount' datatype='real' default-format='p0.0%' name='[Calculation_1755680239673345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Discount])' />
      </column>
      <column caption='Target Status' datatype='string' name='[Calculation_1755680243122178]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Total Revenue]) &gt;= 200000000 THEN &quot;Above Target&quot; ELSE &quot;Below Target&quot; END' />
      </column>
